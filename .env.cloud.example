# Server-only settings. Copy to .env.cloud locally; never commit real values.
# APP_RUNTIME=cloud selects the cloud backend in server.mjs.
APP_RUNTIME=cloud
APP_ORIGIN=https://your-project.vercel.app
# Copy the Transaction pooler URI from Supabase Connect. URL-encode the password.
DATABASE_URL=
# Optional trusted CA PEM from the provider. Never disable TLS verification.
DATABASE_CA_PEM=
ARK_API_KEY=
# The cloud configuration is locked to doubao-seed-2-1-lite-260915.
# Keep Ark's free-quota auto-pause enabled; request limits are not billing caps.
AI_DAILY_CALL_LIMIT=20
AI_USER_DAILY_CALL_LIMIT=3
